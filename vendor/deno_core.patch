diff --git a/runtime/snapshot.rs b/runtime/snapshot.rs
index fb31eca..ccabeb4 100644
--- a/runtime/snapshot.rs
+++ b/runtime/snapshot.rs
@@ -328,7 +328,10 @@ impl SnapshottedData<'_> {
