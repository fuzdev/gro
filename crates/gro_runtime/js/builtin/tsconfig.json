{
	"compilerOptions": {
		"target": "es2024",
		"noLib": true,
		"types": [],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": false
	},
	"include": ["*.d.ts", "@fuzdev/gro/*.ts"]
}
