{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"types": [],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": false
	},
	"include": ["*.js", "*.d.ts"]
}
