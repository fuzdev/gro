#!/bin/sh
# What a launch case's child does, by its first argument.
mode=$1
shift
case $mode in
args) printf '[%s]' "$@" ;;
argv0) printf '%s' "$0" ;;
streams) printf 'out'; printf 'err' >&2 ;;
exit) exit "$1" ;;
signal) ulimit -c 0; kill -"$1" $$ ;;
vars) for name in "$@"; do eval "printf '%s=%s;' \"\$name\" \"\${$name-unset}\""; done ;;
pwd) pwd ;;
cat) cat ;;
bytes) printf '\357\273\277a\377b\303\251c\342\202' ;;
hold) printf '0123456789'; exec sleep 5 ;;
linger) sleep 5 & echo started ;;
sleep) exec sleep "$1" ;;
trap) trap 'kill $! 2>/dev/null; exit 7' TERM; sleep 5 & wait ;;
stubborn) trap '' TERM; exec sleep 5 ;;
real_time_on_term) trap 'kill $! 2>/dev/null; kill -35 $$' TERM; sleep 5 & wait ;;
big) head -c "$1" /dev/zero ;;
echo_err) cat; printf 'err' >&2 ;;
*) exit 99 ;;
esac
