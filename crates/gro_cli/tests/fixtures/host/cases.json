			{
				"at": "/guard/own/name",
				"fgro": {"type": "string", "writable": false, "enumerable": false, "configurable": false},
				"why": "the guard is frozen, so its name isn't configurable"
			},
			{
				"at": "/guards/proxy_of_an_error",
				"fgro": false,
				"why": "the guard is native and runs no code of a caller's, so it reads no proxy's prototype through its trap, and a proxy is no error of the family"
			},
			{
				"at": "/guards/kind_by_getter",
				"fgro": false,
				"why": "the guard is native and runs no code of a caller's, so it reads only a data property's kind, and calls no getter"
			},
			{
				"at": "/guards/named_through_a_proxy",
				"fgro": false,
				"why": "the guard is native and runs no code of a caller's, so it reads no name through a proxy on a constructor's chain, and a proxy there is no match"
			},
			{
